# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional: only needed when the ElevenLabs connector is not available in Claude Code
ELEVENLABS_API_KEY=
# Optional: find_topics.py (outlier topics, title lookalike check) and youtube_stats.py (views / likes / comments).
# Google Cloud console > APIs & Services > enable "YouTube Data API v3" > Credentials > API key. Free: 10,000 units a day.
YOUTUBE_API_KEY=
# Optional: upload.py publishes through Zernio (zernio.com > Settings > API keys; free for up to 2 connected accounts)
ZERNIO_API_KEY=
